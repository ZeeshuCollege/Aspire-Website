# Cloudflare Pages Custom Headers Configuration
# Documentation: https://developers.cloudflare.com/pages/configuration/headers/

# Global Security Headers
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  X-XSS-Protection: 1; mode=block
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# Cache-Control: Fingerprinted static assets (Vite hashed JS, CSS)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Cache-Control: Static media & images
/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/media/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

# Cache-Control: Meta and SEO assets
/favicon.ico
  Cache-Control: public, max-age=86400

/favicon.png
  Cache-Control: public, max-age=86400

/favicon.svg
  Cache-Control: public, max-age=86400

/site.webmanifest
  Cache-Control: public, max-age=86400

/robots.txt
  Cache-Control: public, max-age=86400

/sitemap.xml
  Cache-Control: public, max-age=86400
